// The watch app's identity. It ships inside the iPhone app and reports the watch through it.
#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.santiagotoscanini.daedalus.watchkitapp
INFOPLIST_KEY_CFBundleDisplayName = Daedalus
INFOPLIST_KEY_WKApplication = YES
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = com.santiagotoscanini.daedalus

SDKROOT = watchos
WATCHOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 4
SKIP_INSTALL = YES
